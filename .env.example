# Copy to .env and paste your key. Never commit .env.
ANTHROPIC_API_KEY=
# Optional: hands-free voice with the Gemini Live API. Without it the mic uses push-to-talk.
GEMINI_API_KEY=

# Optional: accounts and sync (Supabase). Without these the app keeps everything on the device.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
